# Copia este archivo como agente/.env y llénalo con los datos de esta computadora.
# El .env no se sube a git: cada computadora tiene el suyo.

# PostgreSQL (si la base no existe, el agente la crea)
DB_HOST=localhost
DB_PUERTO=5432
DB_USUARIO=postgres
DB_CONTRASENA=
DB_NOMBRE=inventario_agente

# Broker del kit (Redpanda)
BROKER=localhost:19092

# Puertos del agente: API y pantallas, y pantallas por https para el celular
PUERTO=8000
PUERTO_HTTPS=8443
